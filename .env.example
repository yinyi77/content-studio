# 在项目根目录复制为 .env.xhs-publisher，重启工作台后生效。
XHS_PUBLISHER_BASE_URL=http://127.0.0.1:8000
XHS_PUBLISHER_ACCOUNT_ID=xhs_account_001
# 填写微服务的 XHS_API_TOKEN 原值。
XHS_PUBLISHER_TOKEN=
# 两台内网机器间送稿时，在工作台电脑上启用独立临时图源。下面是示例，换成实际地址。
# XHS_PUBLISHER_LAN_MEDIA_ORIGIN=http://192.168.1.20:8766
# XHS_PUBLISHER_WORKER_IP=192.168.1.30
# 已有独立图片站点时，可仅配置下面一项。同机同网络命名空间可使用默认回环地址。
# XHS_PUBLISHER_MEDIA_BASE_URL=https://studio-media.example.com
